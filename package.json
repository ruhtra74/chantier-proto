{
  "name": "chantier-proto",
  "version": "0.1.0",
  "private": true,
  "description": "Prototype \u00ab un engin sur un chantier \u00bb (Blender -> Babylon.js/Havok -> Angular, domaine partag\u00e9, API NestJS)",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "dev:web": "pnpm --filter web start",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "decouplage": "pnpm --filter @chantier/domain decouplage",
    "e2e": "pnpm build && pnpm --filter e2e e2e",
    "mesures:fps": "pnpm --filter e2e mesures:fps",
    "mesures:chargement": "pnpm --filter e2e mesures:chargement",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.18.0",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2"
  }
}
