{
  "name": "web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "prestart": "pnpm --filter @chantier/domain build",
    "start": "ng serve",
    "prebuild": "pnpm --filter @chantier/domain build",
    "build": "ng build",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "watch": "ng build --watch --configuration development"
  },
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "dependencies": {
    "@angular/common": "22.2.5",
    "@angular/compiler": "22.2.5",
    "@angular/core": "22.2.5",
    "@angular/forms": "22.2.5",
    "@angular/platform-browser": "22.2.5",
    "@angular/router": "22.2.5",
    "@babylonjs/core": "9.35.0",
    "@babylonjs/havok": "1.3.14",
    "@babylonjs/loaders": "9.35.0",
    "@chantier/domain": "workspace:*",
    "rxjs": "7.8.2",
    "tslib": "2.9.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.6",
    "@angular/cli": "22.2.6",
    "@angular/compiler-cli": "22.2.5",
    "@babylonjs/inspector": "9.35.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3"
  }
}
