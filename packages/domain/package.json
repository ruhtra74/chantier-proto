{
  "name": "@chantier/domain",
  "version": "0.1.0",
  "private": true,
  "description": "R\u00e8gles m\u00e9tier pures du prototype : \u00e9tat, score, r\u00e9ducteur, rejeu",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./scenarios/chantier-1.json": "./scenarios/chantier-1.json"
  },
  "files": [
    "dist",
    "scenarios"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "predecouplage": "tsup",
    "decouplage": "node scripts/decouplage.mjs"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "tsup": "9.0.0",
    "vitest": "5.1.0"
  }
}
